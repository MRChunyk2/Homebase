rules_version = '2';

// ── Advance Psychotherapy Homebase — Firebase Storage rules ──
// File BYTES live here; each file's metadata (name, size, type, uploader, date, Storage path)
// stays in Firestore. Identity matches firestore.rules: Google sign-in restricted to
// @advancepsychotherapy.org, roles from Firestore userRoles/{email} ({ role, staffId }),
// read here with cross-service firestore.get(). Two bootstrap admins are hardcoded.
//
// Paths:
//   onboarding/{token}/{item}/{fileName}     new-hire portal (no sign-in; token is the credential), 10 MB
//   refLibrary/{fileId}/{fileName}           Learning & Reference / Paperwork & Templates, 20 MB
//   staffFiles/{staffId}/{fileId}/{fileName} CEU certificates + Employee File documents, 20 MB
//   applications/{token}/{fileName}          job-application resumes / cover letters (public create), 10 MB
//   policies/{pid}/v{n}/{fileName}           policy PDF versions (immutable), 25 MB
//   policySigned/{email}/{fileName}          each person's signed policy copies, 40 MB
service firebase.storage {
  match /b/{bucket}/o {

    function em() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }
    function isDomain() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && em().matches('.*@advancepsychotherapy[.]org$');
    }
    // Named here rather than looked up, because the firestore.get()/exists()
    // calls below DO NOT WORK in this project's Storage rules — Firebase's rules
    // evaluator rejects them with "Function not found: firestore.exists". So the
    // role lookup always fails and only these hardcoded accounts can write.
    // comms@ is listed because that role is permanent; anyone else who needs to
    // upload must either be added here or the lookup replaced with an auth
    // custom claim (the real fix).
    function isBootstrap() {
      return em() in ['will@advancepsychotherapy.org',
                      'michael@advancepsychotherapy.org',
                      'comms@advancepsychotherapy.org'];
    }
    function hasRoleDoc() {
      return firestore.exists(/databases/(default)/documents/userRoles/$(em()));
    }
    function roleDoc() {
      return firestore.get(/databases/(default)/documents/userRoles/$(em())).data;
    }
    function isAdmin() {
      return isDomain() && (isBootstrap() || (hasRoleDoc() && roleDoc().role in ['admin', 'superadmin']));
    }
    function isSelf(staffId) {
      return isDomain() && hasRoleDoc() && roleDoc().staffId == staffId;
    }
    function under(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // New hires upload via their tokenized link — no sign-in, so the cap stays modest.
    match /onboarding/{token}/{item}/{fileName} {
      allow write: if token.size() >= 20 && under(10);
      // Admins only, matching the onboardFiles rule in firestore.rules. These are
      // CORI checks, resumes and signed tax forms — HR material, not all-staff
      // material. The candidate portal never reads files back (it only writes),
      // so nothing needs wider access.
      allow read: if isAdmin();
    }

    // Job applications (public apply.html, Nov 2026): no sign-in. A candidate can only ADD a resume or
    // cover letter (PDF / Word, 10 MB) under a random 36-character token; only Admins (isAdmin — today the
    // hardcoded accounts above) can read or delete them.
    match /applications/{token}/{fileName} {
      allow create: if token.matches('[0-9a-f]{36}') && under(10)
        && fileName.matches('(resume|cover)_.*[.](pdf|PDF|doc|DOC|docx|DOCX)');
      allow read, delete: if isAdmin();
    }

    // Policy PDFs (Clinical Policies, Nov 2026): every version is a new path and is never replaced or deleted.
    // Everyone signed in reads; only Admins (isAdmin — the hardcoded accounts above) publish.
    match /policies/{pid}/{ver}/{fileName} {
      allow read: if isDomain();
      allow create: if isAdmin() && under(25) && request.resource.contentType == 'application/pdf';
    }
    // Signed copies (policy + signature certificate): written once by the signer into their own email folder.
    match /policySigned/{email}/{fileName} {
      allow create: if isDomain() && em() == email && under(40) && request.resource.contentType == 'application/pdf';
      allow read: if (isDomain() && em() == email) || isAdmin();
    }

    // Library files: everyone signed in reads; admins add and remove.
    match /refLibrary/{fileId}/{fileName} {
      allow read: if isDomain();
      allow create, update: if isAdmin() && under(20);
      allow delete: if isAdmin();
    }

    // A person's own documents (CEU certificates, Employee File): that person and admins.
    match /staffFiles/{staffId}/{fileId}/{fileName} {
      allow read: if isAdmin() || isSelf(staffId);
      allow create, update: if (isAdmin() || isSelf(staffId)) && under(20);
      allow delete: if isAdmin() || isSelf(staffId);
    }

    // Everything else: locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
