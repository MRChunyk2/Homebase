rules_version = '2';

// ── Advance Psychotherapy Homebase — Firestore security rules ──
// These rules are the REAL access control for the app. The UI's
// "Roles & Permissions" page is the steering wheel; this file is the lock.
//
// Identity: Google sign-in, restricted to @advancepsychotherapy.org.
// Roles come from userRoles/{email} docs ({ role, staffId }), which the app
// keeps in sync with its in-app role assignments. Two bootstrap admins are
// hardcoded so the system can never lock everyone out.
//
// Collections:
//   staff/{sid}            roster record (professional info) — all staff read
//   staffPrivate/{sid}     home address / DOB — the person + admins only
//   staffCredentials/{sid} CAQH & PECOS logins — admins only
//   photos/{sid}           avatar photos — all staff read, admins write
//   userRoles/{email}      email → role/staffId map used by these rules
//   kv/{key}               everything else, tiered by key (see below)

service cloud.firestore {
  match /databases/{database}/documents {

    function em() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }
    function isDomain() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && em().matches('.*@advancepsychotherapy[.]org$');
    }
    function isBootstrap() {
      return em() in ['will@advancepsychotherapy.org', 'michael@advancepsychotherapy.org'];
    }
    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/userRoles/$(em()));
    }
    function myRole() {
      return hasRoleDoc()
        ? get(/databases/$(database)/documents/userRoles/$(em())).data.role
        : 'therapist';
    }
    function myStaffId() {
      return hasRoleDoc()
        ? get(/databases/$(database)/documents/userRoles/$(em())).data.staffId
        : '__none__';
    }
    function isAdmin() {
      return isDomain() && (isBootstrap() || myRole() in ['admin', 'superadmin']);
    }
    function isSuperAdmin() {
      return isDomain() && (isBootstrap() || myRole() == 'superadmin');
    }

    match /staff/{sid} {
      allow read: if isDomain();
      allow write: if isAdmin() || (isDomain() && sid == myStaffId());
    }

    match /staffPrivate/{sid} {
      allow read, write: if isAdmin() || (isDomain() && sid == myStaffId());
    }

    match /staffCredentials/{sid} {
      allow read, write: if isAdmin();
    }

    match /photos/{sid} {
      allow read: if isDomain();
      allow write: if isAdmin();
    }

    match /userRoles/{email} {
      allow read: if isDomain();
      allow write: if isAdmin();
    }

    // Public application "mail slot" (the /apply.html form). Anyone may drop
    // one in; only admins can read, list, update, or delete. Creates are
    // validated to look like a real application and size-capped so the open
    // door can't be used to stuff arbitrary junk into the database.
    match /applications/{appId} {
      allow create: if request.resource.data['_name'] is string
        && request.resource.data['_name'].size() > 1
        && request.resource.data['_name'].size() < 200
        && request.resource.data['Email Address'] is string
        && request.resource.data['Email Address'].size() > 4
        && request.resource.data['Email Address'].size() < 200
        && request.resource.data.size() < 60;
      allow read, update, delete: if isAdmin();
    }

    // Individual staff files (CEU certificates and similar), one doc per file
    // so bulk uploads can't blow up the 1MB kv/app_staff blob. Admins manage
    // everyone's; each person can read, file, and delete their OWN (the
    // profile's Training & CEU tab is self-service).
    match /staffFiles/{fid} {
      allow read: if isSuperAdmin() || (isDomain() && resource.data.sid == myStaffId());
      allow create, update: if isAdmin() || (isDomain() && request.resource.data.sid == myStaffId());
      allow delete: if isAdmin() || (isDomain() && resource.data.sid == myStaffId());
    }

    // Candidate interview-availability responses. Written from the public
    // avail.html page via an unguessable token link (no sign-in); only admins
    // can read them back.
    match /availability/{token} {
      allow create, update: if request.resource.data.size() < 12
        && token.size() >= 20;
      allow read, delete: if isAdmin();
    }


    // New-hire onboarding portal docs (onboard.html). The unguessable token IS
    // the credential: whoever holds the link may read and update their own doc
    // (created by an admin when the offer is accepted). Admins see everything.
    // 'list' stays admin-only so tokens can never be enumerated.
    match /onboarding/{token} {
      allow get: if token.size() >= 20 || isAdmin();
      allow create, update: if token.size() >= 20
        && request.resource.data.size() < 40;
      allow list, delete: if isAdmin();
    }

    // Onboarding document uploads (resume, diploma, signed forms, headshot):
    // one doc per file, base64 inside — the free-plan alternative to Firebase
    // Storage, mirroring how avatar photos are stored. The portal token
    // authorizes the create; only admins can read files back.
    match /onboardFiles/{fid} {
      allow create: if request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.b64 is string
        && request.resource.data.b64.size() < 900000
        && request.resource.data.size() < 10;
      allow read, delete: if isAdmin();
    }

    // Meeting & Admin Pay submissions (the in-app Meeting Pay form). Each
    // person files and reads their own; deleting only while still UNPAID.
    // Admins (HR) read everything, mark rows paid, and import history.
    match /meetings/{mid} {
      allow create: if isDomain()
        && request.resource.data.sid is string
        && (isAdmin() || request.resource.data.sid == myStaffId())
        && request.resource.data.size() < 20;
      allow read: if isAdmin() || (isDomain() && resource.data.sid == myStaffId());
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isDomain() && resource.data.sid == myStaffId() && resource.data.status == 'UNPAID');
    }

    // Performance reviews (annual + 6-month check-in). The therapist and
    // their assigned reviewer read and write their own review; admins (HR)
    // manage all of them. Creation/deletion is HR's (window generation).
    match /reviews/{rid} {
      allow read, update: if isAdmin()
        || (isDomain() && (resource.data.sid == myStaffId() || resource.data.reviewerSid == myStaffId()));
      allow create, delete: if isAdmin();
    }

    // Interview-panel availability requests. Admins create one per panel
    // member; the member reads and answers their own from the Home page.
    match /panelAvail/{pid} {
      allow create, delete: if isAdmin();
      allow read, update: if isAdmin() || (isDomain() && resource.data.sid == myStaffId());
    }

    // kv tiers:
    //   superadmin-only: payroll detail
    //   admin-only:      recruiting pipeline, compensation data & checklist
    //   everyone else:   read for all signed-in staff; writes admin-only,
    //                    except therapist-profile drafts (tp_*) which any
    //                    signed-in staff member may save.
    match /kv/{key} {
      allow read: if (key in ['app_payroll_detail', 'app_comp_data', 'app_comp_checklist'] && isSuperAdmin())
        || (key == 'app_recruit' && isAdmin())
        || (!(key in ['app_payroll_detail', 'app_recruit', 'app_comp_data', 'app_comp_checklist']) && isDomain());
      allow write: if (key in ['app_payroll_detail', 'app_comp_data', 'app_comp_checklist'] && isSuperAdmin())
        || (key == 'app_recruit' && isAdmin())
        || (!(key in ['app_payroll_detail', 'app_recruit', 'app_comp_data', 'app_comp_checklist'])
            && (isAdmin() || (isDomain() && key.matches('tp_.*'))));
    }
  }
}
